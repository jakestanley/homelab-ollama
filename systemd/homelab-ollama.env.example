# Copy to /etc/homelab-ollama/homelab-ollama.env and adjust for the host.

# Absolute interpreter path for systemd. Prefer a stable venv or packaged Python.
PYTHON_BIN=/srv/homelab-ollama/.venv/bin/python

# Service listen settings. Replace SERVICE_PORT with the value managed in homelab-infra.
SERVICE_HOST=0.0.0.0
SERVICE_PORT=REPLACE_WITH_HOMELAB_INFRA_PORT

# Ollama runtime settings.
OLLAMA_EXE=/usr/local/bin/ollama
OLLAMA_ARGS=serve
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MANAGED_BY_SERVICE=1
OLLAMA_PROCESS_NAME=ollama
OLLAMA_REQUIRE_SERVE=1
OLLAMA_STOP_SCOPE=all
OLLAMA_STOP_TIMEOUT=8

# Writable service state. Keep this outside the repo for host and Nix-friendly deployments.
STATE_DIR=/var/lib/homelab-ollama

# JSONL job processing.
MAX_UPLOAD_MB=50
JOBS_MAX_WORKERS=1
