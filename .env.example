# Windows NSSM service configuration.
# Docker Compose users do not need this file.

# Service listen settings (replace with the port defined in homelab-infra/registry.yaml)
SERVICE_PORT=REPLACE_WITH_HOMELAB_INFRA_PORT
SERVICE_HOST=0.0.0.0

# Ollama runtime settings
# Prefer a full path for OLLAMA_EXE when running as an NSSM service (services may not inherit your user PATH)
OLLAMA_EXE=ollama
OLLAMA_ARGS=serve
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MANAGED_BY_SERVICE=0
OLLAMA_REQUIRE_SERVE=1
OLLAMA_STOP_SCOPE=all
OLLAMA_STOP_TIMEOUT=8

# State storage
STATE_DIR=data

# JSONL job processing
MAX_UPLOAD_MB=50
JOBS_MAX_WORKERS=1
