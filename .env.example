# Service listen settings (replace with the port defined in homelab-infra/registry.yaml)
SERVICE_PORT=REPLACE_WITH_HOMELAB_INFRA_PORT
SERVICE_HOST=0.0.0.0

# Absolute interpreter path is optional for scripts/up.sh.
# Leave unset for local runs if python3 or .venv/bin/python is already available.
# PYTHON_BIN=/absolute/path/to/python

# Ollama runtime settings
OLLAMA_EXE=ollama
# If running under NSSM/Windows service, prefer a full path (services may not inherit your user PATH)
OLLAMA_ARGS=serve
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
# Set to 1 when the surrounding service should keep `ollama serve` running as part of its own lifecycle.
OLLAMA_MANAGED_BY_SERVICE=0
# Optional override. Leave unset to use the platform default:
# Linux -> ollama
# Windows -> ollama.exe
# OLLAMA_PROCESS_NAME=ollama
OLLAMA_REQUIRE_SERVE=1
OLLAMA_STOP_SCOPE=all
OLLAMA_STOP_TIMEOUT=8

# State storage
# For Linux systemd installs, prefer an absolute writable path such as /var/lib/homelab-ollama.
STATE_DIR=data

# JSONL job processing
# MAX_UPLOAD_MB is enforced by Flask (request size limit)
MAX_UPLOAD_MB=50
# JOBS_MAX_WORKERS controls how many jobs can run concurrently
JOBS_MAX_WORKERS=1
