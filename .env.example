# Required for all running modes
# Replace with the port defined in homelab-infra/registry.yaml
DATA_DIR=/var/lib/homelab-ollama
SERVICE_PORT=20030

# Windows NSSM service configuration only.
# Docker Compose users do not need anything below this line.

# Service listen settings
SERVICE_HOST=0.0.0.0

# Ollama runtime settings
# Prefer a full path for OLLAMA_EXE when running as an NSSM service (services may not inherit your user PATH)
OLLAMA_EXE=ollama
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# State storage
STATE_DIR=data

# JSONL job processing
MAX_UPLOAD_MB=50
JOBS_MAX_WORKERS=1
