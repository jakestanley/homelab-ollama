# Canonical config for homelab-ollama.
# Docker Compose reads DATA_DIR + SERVICE_PORT from this file; the rest of the
# compose env is hardcoded in docker-compose.yml because compose talks to the
# sibling 'ollama' service over the docker network.
# Windows NSSM uses all non-NSSM_* keys.

# Host path for job state (Docker Compose volume mount).
DATA_DIR=/var/lib/homelab-ollama

# HTTP bind. Port ownership stays in homelab-infra.
SERVICE_PORT=20030
SERVICE_HOST=0.0.0.0

# Absolute path to a Python interpreter. Required when .venv/ does not yet
# exist and python.exe is not on PATH (e.g. NSSM running as LocalSystem).
OLLAMA_PYTHON_EXE=/absolute/path/to/python

# Ollama runtime (Windows / NSSM). Prefer a full path for OLLAMA_EXE so
# services running as LocalSystem can find it. up.ps1 auto-fills this from
# PATH if it can.
OLLAMA_EXE=ollama
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# State storage (NSSM mode; compose uses /data inside the container).
STATE_DIR=data

# JSONL job processing.
MAX_UPLOAD_MB=50
JOBS_MAX_WORKERS=1

# Windows NSSM service identity (optional; defaults shown).
# These are consumed by scripts/up.ps1 and not passed to the app.
# NSSM_SERVICE_NAME=homelab-ollama
# NSSM_DISPLAY_NAME=homelab-ollama
# NSSM_DESCRIPTION=Controls local Ollama runtime via HTTP API
